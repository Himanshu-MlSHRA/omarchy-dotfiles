+# Local tweak: a contact with no saved name came through as its raw JID
+# ("919876543210@s.whatsapp.net"). Show just the number, as the phone does.
+# Only display fields are touched; jid/target fields keep the real address.
+_DISPLAY_KEYS = {"name", "title", "sender", "last_sender", "sender_name", "chat_name",
+                 "display_name", "author", "from_name", "subject"}
+_RAW_JID = re.compile(r"^\+?(\d{5,20})(?:@(s\.whatsapp\.net|c\.us|lid))?$")
+
+
+def _pretty_number(text: str) -> str:
+    match = _RAW_JID.match(text.strip())
+    if not match:
+        return text
+    digits, server = match.group(1), match.group(2)
+    if server == "lid":
+        return "Unknown number"
+    if len(digits) == 12 and digits.startswith("91"):
+        return f"+91 {digits[2:7]} {digits[7:]}"
+    if len(digits) == 11 and digits.startswith("1"):
+        return f"+1 {digits[1:4]} {digits[4:7]} {digits[7:]}"
+    return "+" + digits
+
+
+def _prettify_names(value: Any, key: str = "") -> Any:
+    if isinstance(value, dict):
+        return {k: _prettify_names(v, k) for k, v in value.items()}
+    if isinstance(value, list):
+        return [_prettify_names(v, key) for v in value]
+    if isinstance(value, str) and key in _DISPLAY_KEYS and (value[:1] == "+" or value[:1].isdigit()):
+        return _pretty_number(value)
+    return value
+
+
 def emit(value: dict[str, Any], code: int = 0) -> int:
-    print(json.dumps(value, ensure_ascii=False, separators=(",", ":")))
+    print(json.dumps(_prettify_names(value), ensure_ascii=False, separators=(",", ":")))
     return code
 
 
