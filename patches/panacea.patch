diff -ruN -x '*.bak*' -x last_wifi_ssid -x settings.json a/Pal.qml panacea/Pal.qml
--- a/Pal.qml	1970-01-01 05:30:00.000000000 +0530
+++ b/Pal.qml	2026-10-19 21:57:24.600402325 +0530
@@ -0,0 +1,46 @@
+pragma Singleton
+
+import QtQuick
+import Quickshell
+import Quickshell.Io
+
+// Light/dark switch for the whole pill (local addition, not upstream Panacea).
+//
+// Panacea's Nothing look is white ink on a black pill. On a pitch-black
+// wallpaper (or a Shan Shui painting on black paper) a black pill vanishes, so
+// the pill flips to beige with pitch-black ink. Every white literal in the
+// views goes through `fg` / `fa()` here; `bg` is the pill itself.
+// island-backdrop.sh measures what is right behind the pill.
+Singleton {
+    id: pal
+
+    property bool light: false
+
+    readonly property color beige: "#E8DCC4"
+    readonly property color fg: light ? "#000000" : "#ffffff"
+    readonly property color bg: light ? beige : "#000000"
+    // white-at-alpha in the original, i.e. "ink at this alpha"
+    function fa(a) { return light ? Qt.rgba(0, 0, 0, a) : Qt.rgba(1, 1, 1, a) }
+
+    Process {
+        id: probe
+        command: [Quickshell.env("HOME") + "/.config/omarchy/plugins/anshu.bar/island-backdrop.sh"]
+        stdout: StdioCollector {
+            waitForEnd: true
+            onStreamFinished: {
+                try {
+                    var lum = Number(JSON.parse(String(text || "").trim()).lum)
+                    // hysteresis: a wallpaper on the edge does not flicker
+                    pal.light = pal.light ? lum < 0.08 : lum < 0.05
+                } catch (e) {}
+            }
+        }
+    }
+    Timer {
+        interval: 3000
+        repeat: true
+        running: true
+        triggeredOnStart: true
+        onTriggered: if (!probe.running) probe.running = true
+    }
+}
