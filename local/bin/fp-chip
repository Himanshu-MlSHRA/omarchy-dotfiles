#!/usr/bin/env python3
# Inspect / wipe the on-chip print storage of the match-on-chip sensor.
# Usage: sudo fp-chip [list|clear]   (stops fprintd while it runs)
import subprocess, sys
import gi
gi.require_version("FPrint", "2.0")
from gi.repository import FPrint

mode = sys.argv[1] if len(sys.argv) > 1 else "list"
subprocess.run(["systemctl", "stop", "fprintd"], check=False)

ctx = FPrint.Context()
devs = ctx.get_devices()
if not devs:
    sys.exit("no fingerprint device found")
dev = devs[0]
dev.open_sync()
print("device:", dev.get_name(), "| storage:", dev.has_storage())
try:
    prints = dev.list_prints_sync()
    print(f"{len(prints)} print(s) on chip:")
    for p in prints:
        print("  -", p.get_username(), p.get_finger(), p.get_description())
    if mode == "clear":
        dev.clear_storage_sync()
        print("chip storage cleared")
        print("now on chip:", len(dev.list_prints_sync()))
finally:
    dev.close_sync()
